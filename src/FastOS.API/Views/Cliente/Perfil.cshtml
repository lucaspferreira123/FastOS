<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Perfil do Cliente - FastOS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body { background: #f4f6f9; }

        .avatar {
            width: 72px; height: 72px;
            border-radius: 50%;
            background: linear-gradient(135deg, #dc3545, #a71d2a);
            display: flex; align-items: center; justify-content: center;
            font-size: 2rem; color: #fff; font-weight: 700;
            flex-shrink: 0;
        }

        .card-perfil {
            border: none;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
        }

        .card-indicador {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
            transition: transform .15s;
        }
        .card-indicador:hover { transform: translateY(-2px); }

        .icon-box {
            width: 46px; height: 46px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem;
        }

        .badge-status { font-size: .72rem; padding: .3em .65em; border-radius: 6px; }

        .equip-tag {
            display: inline-block;
            background: #f0f0f0;
            border: 1px solid #ddd;
            border-radius: 20px;
            padding: 4px 14px;
            font-size: .8rem;
            color: #444;
            margin: 3px;
        }

        .section-title {
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #6c757d;
            margin-bottom: .75rem;
        }

        .table-os th { font-size: .78rem; text-transform: uppercase; color: #6c757d; }

        .spinner-overlay {
            position: fixed; inset: 0;
            background: rgba(255,255,255,.75);
            display: flex; align-items: center; justify-content: center;
            z-index: 9999;
        }
    </style>
</head>
<body>
    <partial name="_SidebarMenu" />

    <div id="spinnerOverlay" class="spinner-overlay">
        <div class="spinner-border text-danger" style="width:3rem;height:3rem;" role="status"></div>
    </div>

    <div class="container-fluid px-4 py-3" id="conteudo" style="display:none">

        <!-- Voltar -->
        <div class="mb-3">
            <a href="/Home" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Voltar para OS
            </a>
        </div>

        <!-- Card principal do cliente -->
        <div class="card card-perfil mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-4 flex-wrap">
                    <div class="avatar" id="avatarLetra">?</div>
                    <div class="flex-grow-1">
                        <h4 class="fw-bold mb-1" id="clienteNome">—</h4>
                        <div class="d-flex flex-wrap gap-3 text-muted" style="font-size:.9rem">
                            <span><i class="bi bi-envelope me-1"></i><span id="clienteEmail">—</span></span>
                            <span><i class="bi bi-telephone me-1"></i><span id="clienteTelefone">—</span></span>
                            <span><i class="bi bi-geo-alt me-1"></i><span id="clienteEndereco">—</span></span>
                        </div>
                        <div class="mt-2 d-flex gap-2 flex-wrap">
                            <span class="badge bg-secondary" id="clienteTipo">—</span>
                            <span class="badge bg-light text-dark border" id="clienteDocumento">—</span>
                            <span id="clienteAtivo"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Indicadores -->
        <p class="section-title">Resumo</p>
        <div class="row g-3 mb-4" id="indicadores"></div>

        <!-- Equipamentos atendidos -->
        <p class="section-title">Serviços Realizados</p>
        <div class="card card-perfil mb-4 p-3">
            <div id="equipamentos" class="d-flex flex-wrap gap-1">
                <span class="text-muted small">Nenhum serviço registrado.</span>
            </div>
        </div>

        <!-- Histórico de OS -->
        <p class="section-title">Histórico de Ordens de Serviço</p>
        <div class="card card-perfil mb-4">
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-os mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Descrição</th>
                                <th>Status</th>
                                <th>Abertura</th>
                                <th>Previsão</th>
                                <th>Pago</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyOS"></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const idCliente = parseInt(window.location.pathname.split('/').pop());

        const statusCores = {
            'Aguardando Analise e Requisição': 'secondary',
            'Gerando Orcamento':               'primary',
            'Aguardando Aprovação':            'warning',
            'Ordem em Execução':               'info',
            'Concluída / Aguardando Pagamento':'success',
            'Concluída / Pagamento Realizado': 'success',
            'Cancelada':                       'danger'
        };

        const configIndicadores = [
            { key: 'totalOS',      label: 'Total de OS',      icon: 'bi-clipboard2-data-fill', cor: '#dc3545', bg: '#fde8ea' },
            { key: 'osAbertas',    label: 'Em Aberto',        icon: 'bi-gear-fill',            cor: '#0d6efd', bg: '#e7f0ff' },
            { key: 'osConcluidas', label: 'Concluídas',       icon: 'bi-check-circle-fill',    cor: '#198754', bg: '#e6f4ec' },
            { key: 'osAtrasadas',  label: 'Atrasadas',        icon: 'bi-exclamation-triangle-fill', cor: '#ffc107', bg: '#fff8e1' },
            { key: 'totalGasto',   label: 'Total Gasto',      icon: 'bi-cash-coin',            cor: '#6f42c1', bg: '#f0ebff', moeda: true },
            { key: 'ticketMedio',  label: 'Ticket Médio',     icon: 'bi-graph-up-arrow',       cor: '#0dcaf0', bg: '#e0f9ff', moeda: true },
        ];

        function fmt(data) {
            if (!data) return '—';
            return new Date(data).toLocaleDateString('pt-BR');
        }

        function fmtMoeda(v) {
            return 'R$ ' + parseFloat(v).toLocaleString('pt-BR', { minimumFractionDigits: 2 });
        }

        $.ajax({
            url: `/Cliente/ObterPerfil/${idCliente}`,
            type: 'GET',
            success: function (p) {
                // Avatar
                document.getElementById('avatarLetra').textContent = p.nome.charAt(0).toUpperCase();

                // Dados principais
                document.getElementById('clienteNome').textContent      = p.nome;
                document.getElementById('clienteEmail').textContent     = p.email || '—';
                document.getElementById('clienteTelefone').textContent  = p.telefone || '—';
                document.getElementById('clienteEndereco').textContent  = p.endereco || '—';
                document.getElementById('clienteTipo').textContent      = p.tipoCliente;
                document.getElementById('clienteDocumento').textContent = p.documento || '—';
                document.getElementById('clienteAtivo').innerHTML       = p.ativo
                    ? '<span class="badge bg-success">Ativo</span>'
                    : '<span class="badge bg-danger">Inativo</span>';

                // Indicadores
                const elInd = document.getElementById('indicadores');
                elInd.innerHTML = configIndicadores.map(cfg => {
                    const val = p[cfg.key];
                    const display = cfg.moeda ? fmtMoeda(val) : val;
                    return `
                    <div class="col-6 col-sm-4 col-lg-2">
                      <div class="card card-indicador p-3">
                        <div class="d-flex align-items-center gap-3">
                          <div class="icon-box" style="background:${cfg.bg};color:${cfg.cor}">
                            <i class="bi ${cfg.icon}"></i>
                          </div>
                          <div>
                            <div class="fw-bold" style="color:${cfg.cor};font-size:${cfg.moeda?'1rem':'1.4rem'}">${display}</div>
                            <div class="text-muted" style="font-size:.72rem">${cfg.label}</div>
                          </div>
                        </div>
                      </div>
                    </div>`;
                }).join('');

                // Equipamentos
                const elEquip = document.getElementById('equipamentos');
                if (p.equipamentos && p.equipamentos.length > 0) {
                    elEquip.innerHTML = p.equipamentos
                        .map(e => `<span class="equip-tag"><i class="bi bi-tools me-1"></i>${e}</span>`)
                        .join('');
                }

                // Tabela de OS
                const tbody = document.getElementById('tbodyOS');
                if (!p.ordens || p.ordens.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">Nenhuma ordem encontrada</td></tr>';
                } else {
                    tbody.innerHTML = p.ordens.map(o => {
                        const cor = statusCores[o.statusDescricao] || 'secondary';
                        const atrasada = !([5,6].includes(o.idStatus)) && new Date(o.previsaoEntrega) < new Date();
                        return `<tr>
                            <td><span class="fw-semibold">#${o.idOrdemServico}</span></td>
                            <td class="text-truncate" style="max-width:260px" title="${o.descricaoServico}">${o.descricaoServico}</td>
                            <td><span class="badge badge-status bg-${cor}">${o.statusDescricao}</span></td>
                            <td>${fmt(o.dataAbertura)}</td>
                            <td>${atrasada ? '<span class="text-danger fw-semibold">'+fmt(o.previsaoEntrega)+' ⚠</span>' : fmt(o.previsaoEntrega)}</td>
                            <td>${o.pago ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>'}</td>
                        </tr>`;
                    }).join('');
                }

                document.getElementById('spinnerOverlay').style.display = 'none';
                document.getElementById('conteudo').style.display = 'block';
            },
            error: function () {
                document.getElementById('spinnerOverlay').style.display = 'none';
                document.body.innerHTML += '<div class="alert alert-danger m-4">Erro ao carregar perfil do cliente.</div>';
            }
        });
    </script>
</body>
</html>
