@{ ViewData["Title"] = "Ordens de Servi\u00E7o"; }
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
<link rel="stylesheet" href="~/lib/dataTables/datatables.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
    <partial name="_SidebarMenu" />

    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="text-danger fw-bold">Ordens de Serviço</h2>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalCadastroOS">
                <i class="bi bi-file-earmark-plus-fill me-1"></i> Nova OS
            </button>
        </div>
    </div>

       @*  <div class="mb-3">
            <input type="text" id="searchInput" class="form-control" placeholder="Buscar por cliente, serviço ou status...">
        </div> *@

        <div class="table-responsive">
            <table class="table table-bordered table-striped" id="tabelaOrdens">
                <thead class="table-light">
                    <tr>
                        <th>Nº OS</th>
                        <th>Cliente</th>
                        <th>Pago</th>
                        <th>Status</th>
                        <th>Data Abertura</th>
                        <th>Previsão Entrega</th>
                        <th>Funções</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>

        <div class="modal" id="modalCadastroOS" tabindex="-1" aria-labelledby="modalCadastroOSLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content rounded-4 shadow-lg border-0">

                    <div class="modal-header bg-light border-bottom-0 pb-0">
                        <h5 class="modal-title text-danger fw-bold" id="modalCadastroOSLabel">Nova Ordem de Serviço</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>

                    <div class="modal-body">

                        @Html.AntiForgeryToken()

                        <div class="row g-4">

                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Cliente</label>
                                <select id="selectCriarOrdemCliente" class="form-select">
                                    <option value="">Selecione um cliente</option>
                                    @foreach (var cliente in ViewBag.Clientes)
                                    {
                                        <option value="@cliente.idCliente">@cliente.Nome</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Data de Abertura</label>
                                <input type="date" class="form-control" id="txtCriarOrdemDataAbertura" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Previsão de Finalização</label>
                                <input type="date" class="form-control" id="txtCriarOrdemPrevisaoEntrega">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Status</label>
                                <select class="form-select" id="selectCriarOrdemStatus" required>
                                    <option value="">Selecione o status</option>
                                    @foreach (var status in ViewBag.Status)
                                    {
                                        <option value="@status.idStatus">@status.Descricao</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Descrição do Problema</label>
                                <textarea class="form-control" id="txtCriarOrdemDescricao" rows="3"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Diagnóstico técnico do equipamento</label>
                                <textarea class="form-control" id="txtCriarOrdemDiagnosticoTecnico" rows="4"></textarea>
                                <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="PrepararImportacaoDiagnostico('criar')">Importar diagnóstico do computador (.json)</button>
                                <label for="relatorioPdfOrdem" class="form-label d-block mt-3">Relat&#243;rio PDF do diagn&#243;stico (opcional)</label>
                                <input id="relatorioPdfOrdem" type="file" accept="application/pdf,.pdf" class="form-control">
                                <div id="relatorioPdfSelecionado" class="form-text" aria-live="polite">Nenhum relat&#243;rio selecionado.</div>
                            </div>

                        </div>

                    </div>

                    <div class="modal-footer border-top-0 mt-2">
                        <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Fechar</button>
                        <button type="button" class="btn btn-danger px-4 fw-bold" onclick="CriarOrdem()">Cadastrar Ordem</button>
                    </div>

                </div>
            </div>
        </div>

    <div class="modal" id="modalEditarOS" tabindex="-1" aria-labelledby="modalEditarOSLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 shadow-lg border-0">

                <div class="modal-header bg-light border-bottom-0 pb-0">
                    <h5 class="modal-title text-danger fw-bold" id="modalEditarOSLabel">Editar Ordem de Serviço</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">
                    @Html.AntiForgeryToken()

                    <div class="row g-4">

                        <div class="col-md-12">
                                <label class="form-label fw-semibold">Cliente</label>
                            <select id="selectEditarOrdemCliente" class="form-select selectpicker">
                                    <option value="">Selecione um cliente</option>
                                    @foreach (var cliente in ViewBag.Clientes)
                                    {
                                            <option value="@cliente.idCliente">@cliente.Nome</option>
                                    }
                                </select>
                            </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Data de Abertura</label>
                            <input type="date" class="form-control" id="txtEditarOrdemDataAbertura" required>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Previsão de Finalização</label>
                            <input type="date" class="form-control" id="txtEditarOrdemPrevisaoEntrega">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select class="form-select selectpicker" id="selectEditarOrdemStatus" required>
                                <option value="">Selecione o status</option>
                                @foreach (var status in ViewBag.Status)
                                {
                                    <option value="@status.idStatus">@status.Descricao</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Descrição do Problema</label>
                            <textarea class="form-control" id="txtEditarOrdemDescricao" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Diagnóstico técnico do equipamento</label>
                            <textarea class="form-control" id="txtEditarOrdemDiagnosticoTecnico" rows="4"></textarea>
                            <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="PrepararImportacaoDiagnostico('editar')">Importar diagnóstico do computador (.json)</button>
                        </div>

                    </div>

                </div>

                <div class="modal-footer border-top-0 mt-2">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-danger px-4 fw-bold" onclick="AlterarOrdem()">Alterar Ordem</button>
                </div>

            </div>
        </div>
    </div>

        <div class="modal fade" id="modalConfirmarExclusao" tabindex="-1" aria-labelledby="modalConfirmarExclusaoLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4">
                    <div class="modal-header bg-light border-0">
                        <h5 class="modal-title text-danger fw-bold" id="modalConfirmarExclusaoLabel">
                            Confirmar Exclusão de OS
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body fs-5 text-center">
                        <p>Tem certeza que deseja excluir a Ordem de Serviço <strong id="numeroOSExclusao"></strong>?</p>
                        <p class="text-muted mb-0">Essa ação não poderá ser desfeita.</p>
                    </div>
                    <div class="modal-footer border-0 justify-content-center">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="button" id="btnConfirmarExclusao" class="btn btn-danger px-4">
                            <i class="bi bi-trash-fill me-1"></i>Excluir OS
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modalAdicionarPecas" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content rounded-4">
                    <div class="modal-header">
                        <h5 class="modal-title text-danger fw-bold">Adicionar Peças</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">

                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Quantidade</label>
                                <input type="number" class="form-control" id="txtQuantidadePeca" min="1" value="1">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Produto</label>
                                <select id="selectCriarOrdemProduto" class="form-select">
                                    <option value="">Selecione um produto</option>
                                    @foreach (var produto in ViewBag.Produtos)
                                    {
                                        <option value="@produto.Id">@produto.Codigo - @produto.Descricao</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="button" class="btn btn-dark w-100" id="btnAddPeca" onclick="AdicionarPeca()">
                                    + Adicionar Peça
                                </button>
                            </div>
                            <div class="col-md-12"></div>

                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Codigo</th>
                                        <th>Peça</th>
                                        <th>Qtd</th>
                                        <th>Funções</th>
                                    </tr>
                                </thead>
                                <tbody id="listaPecas">
                                    <!-- linhas dinâmicas -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger" id="btnSalvarPecas" onclick="SalvarItens()">Salvar</button>
                    </div>
                </div>
            </div>
        </div>

    <div class="modal" id="modalOrcamentoOS" tabindex="-1" aria-labelledby="modalOrcamentoOSLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 shadow-lg border-0">

                <div class="modal-header bg-light border-bottom-0 pb-0">
                    <h5 class="modal-title text-danger fw-bold" id="modalOrcamentoOSLabel">Orçamento da Ordem de Serviço</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Valor da Mão de Obra (R$)</label>
                            <input type="number" class="form-control" id="txtOrcamentoMaoDeObra"  onchange="CalcularValorOrcamento()">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Valor dos Materiais (R$)</label>
                            <input type="number" class="form-control" id="txtOrcamentoMateriais"  onchange="CalcularValorOrcamento()" disabled>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Desconto (%)</label>
                            <input type="number" class="form-control" id="txtOrcamentoDesconto"  onchange="CalcularValorOrcamento()">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Taxas Extras (R$)</label>
                            <input type="number" class="form-control" id="txtOrcamentoTaxas"  onchange="CalcularValorOrcamento()">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Valor Final (R$)</label>
                            <input type="number" class="form-control" id="txtOrcamentoValorFinal"  disabled>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Forma de pagamento</label>
                            <input type="text" class="form-control" id="txtOrcamentoFormaPagamento">
                        </div>

                    </div>

                </div>

                <div class="modal-footer border-top-0 mt-2">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-danger px-4 fw-bold" onclick="SalvarOrcamento()">Salvar Orçamento</button>
                </div>

            </div>
        </div>
    </div>


        <div class="modal fade" id="modalImportarDiagnostico" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Importar diagnóstico do computador</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <div id="diagnosticImportMessage" class="d-none" role="alert"></div>
                    <p class="text-muted">Prévia do arquivo antes de aplicar. Escolha as seções que serão anexadas ao campo separado de diagnóstico técnico. A descrição do problema, cliente, status, valores e peças não serão alterados. A OS só será salva pelo botão normal do formulário.</p>
                    <label for="diagnosticJsonFile" class="form-label">Arquivo JSON</label><input id="diagnosticJsonFile" type="file" accept=".json,application/json" class="form-control">
                    <div id="diagnosticPreview" class="mt-3" aria-live="polite"></div>
                    <div id="diagnosticSections" class="mt-3" hidden>
                        <div class="fw-semibold mb-2">Informações a aplicar</div>
                        <div class="form-check"><input class="form-check-input diagnostic-section" type="checkbox" value="computer" id="includeDiagnosticComputer" checked><label class="form-check-label" for="includeDiagnosticComputer">Identificação e sistema operacional</label></div>
                        <div class="form-check"><input class="form-check-input diagnostic-section" type="checkbox" value="hardware" id="includeDiagnosticHardware" checked><label class="form-check-label" for="includeDiagnosticHardware">Processador, memória, discos, gráficos e sensores</label></div>
                        <div class="form-check"><input class="form-check-input diagnostic-section" type="checkbox" value="health" id="includeDiagnosticHealth" checked><label class="form-check-label" for="includeDiagnosticHealth">Resumo, alertas e avisos de coleta</label></div>
                    </div>
                    <label for="diagnosticPdfFile" class="form-label mt-3">Relatório PDF (opcional)</label><input id="diagnosticPdfFile" type="file" accept="application/pdf,.pdf" class="form-control">
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar importação</button><button id="confirmDiagnosticImport" type="button" class="btn btn-primary" disabled>Aplicar dados selecionados</button></div>
            </div></div>
        </div>

        <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:2000"></div>

@section Scripts {
    <script src="~/lib/dataTables/datatables.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
    <script src="~/js/pages/Ordem.js" asp-append-version="true"></script>
}
